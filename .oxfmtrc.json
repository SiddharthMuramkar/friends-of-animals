{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "ignorePatterns": [
    "public/**",
    "drizzle/meta/**",
    "pnpm-lock.yaml",
    "AGENTS.md"
  ]
}
