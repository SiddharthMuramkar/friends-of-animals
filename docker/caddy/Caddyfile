# Caddy on the VPS (edge.yml, #118). Host network: firewalld governs 80 and
# 443. Runbook: docker/README.md, "Edge (Caddy)".

# Every log line Caddy writes about a request, the access log and the error
# log alike, as JSON without the headers that carry the visitor's address,
# location or page: no PII in logs (#118). Caddy already redacts Cookie,
# Set-Cookie and Authorization. What stays is what CrowdSec's caddy parser
# uses (client_ip, host, method, uri, status, User-Agent).
(no_visitor) {
	format filter {
		wrap json
		fields {
			request>headers>X-Real-Ip delete
			request>headers>X-Forwarded-For delete
			request>headers>Forwarded delete
			request>headers>X-Vercel-Forwarded-For delete
			request>headers>X-Vercel-Ip-Continent delete
			request>headers>X-Vercel-Ip-Country delete
			request>headers>X-Vercel-Ip-Country-Region delete
			request>headers>X-Vercel-Ip-City delete
			request>headers>X-Vercel-Ip-Postal-Code delete
			request>headers>X-Vercel-Ip-Latitude delete
			request>headers>X-Vercel-Ip-Longitude delete
			request>headers>X-Vercel-Ip-Timezone delete
			request>headers>Referer delete
		}
	}
}

{
	# Let's Encrypt's production CA, pinned. On a new host, point this at the
	# staging CA (https://acme-staging-v02.api.letsencrypt.org/directory)
	# until issuance works, then back (README.md).
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	# A unix socket under /config, root-only: on the host network a TCP
	# port would be open to every local process. Healthcheck and reload use
	# it (edge.yml).
	admin unix//config/admin.sock|0600
	# Caddy's own log on stderr (journald, PRIORITY 3; CrowdSec doesn't
	# read it). A request whose upstream fails lands here with its headers,
	# a log_skip one included.
	log default {
		output stderr
		import no_visitor
	}
	servers {
		protocols h1 h2
	}
}

# The stats and errors sites' access log: on stdout, which the logging
# driver sends to journald (edge.yml) and CrowdSec reads from there
# (crowdsec/acquis-foa-caddy.yaml). Each site also skips the requests
# Vercel proxies for visitors (log_skip), so a page view logs nothing.
(access_log) {
	log {
		output stdout
		import no_visitor
	}
}

# db.* only need port 80, for lego's webroot HTTP-01 renewals of PgBouncer's
# certificate (one certificate for both names). Explicit http:// so Caddy
# never manages a certificate for these names.
http://db.friendsofanimals.dev, http://db.shipped-it.dev {
	handle /.well-known/acme-challenge/* {
		root * /srv/acme
		file_server
	}
	handle {
		respond 404
	}
}

# GlitchTip (errors.yml), on its own bridge.
errors.friendsofanimals.dev {
	import access_log
	# Sentry envelopes from the site's /monitoring tunnel and its server
	# SDK, all from Vercel's shared egress: never logged, so never counted
	# towards a CrowdSec ban (a ban would cut Vercel off from PgBouncer too).
	# Every method and query string: what Vercel sends is never the
	# visitor's to choose. The cost: CrowdSec doesn't see anyone, a direct
	# scanner included, on this path (README.md, TODO "Edge rate limit").
	@envelope {
		path_regexp ^/api/[0-9]+/envelope/$
	}
	log_skip @envelope
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy 10.112.13.10:8000
}

# Umami (analytics.yml), on pg-prod's bridge: its dashboard, and the tracker
# and collection endpoint the site reaches through Next's /stats rewrites.
stats.friendsofanimals.dev {
	import access_log
	# The tracker script and page views the site's /stats rewrites proxy
	# (src/lib/analytics/umami.ts): every visitor's, from Vercel's shared
	# egress. Never logged, so neither kept nor counted towards a ban.
	# Every method and query string: the rewrites match the path only and
	# forward both, so a visitor picking `PUT /stats/script.js` or a probe
	# query must not get Vercel's address logged. The cost: CrowdSec doesn't
	# see anyone, a direct scanner included, on these two paths (README.md,
	# TODO "Edge rate limit").
	@tracker {
		path /script.js /api/send
	}
	log_skip @tracker
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# The bootstrap creates this file only after replacing Umami's seeded login.
	@closed not file {
		root /srv/gates
		try_files /stats
	}
	respond @closed 503
	# Umami reads the visitor's address from X-Real-IP (CLIENT_IP_HEADER in
	# analytics.yml), which Vercel's rewrite sets, replacing the browser's.
	# Without it Umami falls back to the first CDN header it finds: drop
	# the ones a browser could add through the rewrite. This doesn't make
	# the address unforgeable: Umami 3.5.0 prefers an `ip` in the
	# /api/send body, and a request sent here directly sets its own
	# X-Real-IP. Only the counts are at stake (README.md, Analytics).
	reverse_proxy 10.112.12.30:3000 {
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		header_up -X-Client-IP
		header_up -Fastly-Client-IP
		header_up -X-Nf-Client-Connection-Ip
		header_up -Do-Connecting-Ip
	}
}
