{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [".next/**", "next-env.d.ts", "drizzle/**", "public/**"],
  "overrides": [
    {
      "files": ["src/**/*.tsx"],
      "rules": {
        "react/jsx-no-literals": [
          "error",
          {
            "noStrings": true,
            "ignoreProps": true,
            "allowedStrings": [
              "·",
              "—",
              "–",
              "/",
              "|",
              ":",
              "(",
              ")",
              " ",
              "&nbsp;"
            ],
            "restrictedAttributes": [
              "alt",
              "aria-label",
              "aria-description",
              "aria-roledescription",
              "aria-valuetext",
              "title",
              "placeholder",
              "label"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.test.tsx", "src/components/ui/**"],
      "rules": {
        "react/jsx-no-literals": "off"
      }
    }
  ]
}
