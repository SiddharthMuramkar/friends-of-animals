# Copy to .env for local development:  cp .env.example .env
# Next.js, drizzle-kit and `pnpm db:migrate` all read it. The values below
# match the `db` service in docker-compose.yml.

# --- App --------------------------------------------------------------------
# Which deployment this is: local | preview | staging | production.
# Branch on APP_ENV for behaviour switches, not on VERCEL_ENV.
# Defaults to local; every Vercel environment must set it.
APP_ENV=local

# Canonical base URL of the site, used for absolute URLs such as Open Graph
# images. Only the server reads it, so it has no NEXT_PUBLIC_ prefix, but
# prerendered pages bake it in at build time: set it for `next build` too.
# Defaults to http://localhost:3000, but only APP_ENV=local may leave it unset.
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Runtime connection used by the app. The server won't start without it
# (src/instrumentation.ts); `next build` works without it.
#   Local:  postgres://foa:foa@localhost:5432/foa  (docker compose up -d db)
#   Vercel: PgBouncer on the VPS, transaction mode over TLS (set up in #12)
DATABASE_URL=postgres://foa:foa@localhost:5432/foa

# Direct connection for `pnpm db:migrate` and drizzle-kit, which never fall
# back to DATABASE_URL (a transaction-mode pooler on Vercel).
#   Local:  the same URL as DATABASE_URL
#   Vercel: the PgBouncer session-mode entry with the migrator role (#12)
DIRECT_URL=postgres://foa:foa@localhost:5432/foa
