# Copy to .env for local development:  cp .env.example .env
# Next.js, drizzle-kit and `pnpm db:migrate` all read it. The values below
# match the `db` service in docker-compose.yml.

# --- App --------------------------------------------------------------------
# Which deployment this is: local | preview | staging | production.
# Branch on APP_ENV for behaviour switches, not on VERCEL_ENV.
# Defaults to local; every Vercel environment must set it.
APP_ENV=local

# Canonical base URL of the site, used for absolute URLs such as Open Graph
# images. Only the server reads it, so it has no NEXT_PUBLIC_ prefix, but
# prerendered pages bake it in at build time: set it for `next build` too.
# Defaults to http://localhost:3000 locally and to https://$VERCEL_BRANCH_URL
# on a Vercel preview; staging and production must set it.
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# On Vercel both URLs go to PgBouncer on the VPS over TLS, checked against
# its Let's Encrypt certificate:
#   postgres://<role>:<password>@db.friendsofanimals.dev:6432/<database>?sslmode=verify-full
# PgBouncer sends database `foa` to pg-prod and every other name to
# pg-nonprod (foa_staging and the preview databases).
#   Production: database foa,         roles foa_app / foa_migrator
#   Staging:    database foa_staging, roles staging_app / staging_migrator
#   Preview:    database foa_pr (a placeholder), roles nonprod_app /
#               nonprod_migrator. The app, `pnpm db:migrate` and `pnpm db:seed`
#               swap in the preview's own database, foa_pr_<PR number>_<fp>,
#               or foa_br_<branch>_<hash>_<fp> before the branch has a PR
#               (<fp>: the migrations fingerprint); the migration creates it
#               from the foa_seed template.
# Locally there is no sslmode, so the connection stays plain.

# Runtime connection used by the app. The server won't start without it
# (src/instrumentation.ts); `next build` works without it.
#   Local:  postgres://foa:foa@localhost:5432/foa  (docker compose up -d db)
#   Vercel: the app role (DML only), which PgBouncer pools by transaction
DATABASE_URL=postgres://foa:foa@localhost:5432/foa

# Connection for `pnpm db:migrate` and drizzle-kit, which never fall back to
# DATABASE_URL (transaction pooling breaks the migration's advisory lock).
#   Local:  the same URL as DATABASE_URL
#   Vercel: the migrator role (schema owner), which PgBouncer gives session
#           mode through its per-user pool_mode
DIRECT_URL=postgres://foa:foa@localhost:5432/foa

# --- Sign-in -----------------------------------------------------------------
# Signs session cookies and keys the sign-in code rate limits. Staging and
# production must each set their own (32+ characters): openssl rand -hex 32.
# A local run or a preview without it uses a public development secret.
# BETTER_AUTH_SECRET=

# Outside production every email and SMS goes to the capture mailbox instead
# of being sent. GET /api/capture-mailbox with the headers
# x-capture-mailbox-to: <address or phone number> and
# x-capture-mailbox-token: <this value> reads it (the Seam 2 journeys do).
# Unset, the mailbox stays closed (404). Never set in production.
# CAPTURE_MAILBOX_TOKEN=

# --- Personal data -----------------------------------------------------------
# Encrypts personal-data columns (a user's phone) and keys the blind index
# that finds them. FIELD_ENCRYPTION_KEYS is a key ring of
# "<version>:<base64 32 bytes>" entries, comma-separated; the highest version
# encrypts, every listed key decrypts:  1:$(openssl rand -base64 32)
# FIELD_HMAC_KEY is one key:  openssl rand -base64 32
# Staging and production must set both, and keep an offline copy: a lost key
# loses every value stored under it. To rotate, add version 2, re-encrypt,
# then drop version 1; a new FIELD_HMAC_KEY needs every blind index
# recomputed. A local run or a preview without them uses public development
# keys (src/server/crypto/keys.ts), fit only for seed and test data.
# FIELD_ENCRYPTION_KEYS=
# FIELD_HMAC_KEY=

# --- SMS ---------------------------------------------------------------------
# Production sends SMS through MSG91 once FOA's DLT registration is approved:
# the account's auth key and the MSG91 id of the DLT-approved sign-in code
# template (variables ##code## and ##minutes##; the sender ID is mapped to the
# template in the MSG91 panel). Without them production refuses to send SMS.
# Every other environment captures SMS and never calls MSG91, so leave these
# unset outside production.
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# The DLT-approved coordinator invitation template (#74), once registered.
# MSG91_COORDINATOR_INVITATION_TEMPLATE_ID=

# --- Email -------------------------------------------------------------------
# Production sends email through Amazon SES (v2 SendEmail) once FOA's SES
# account is set up: an IAM key pair allowed to send, and the sender (a
# verified identity, e.g. Friends of Animals <no-reply@friendsofanimals.dev>).
# Set the key id, the secret and the sender together, or none: without them
# production refuses to send email. SES_REGION defaults to ap-south-1, and
# SES_CONFIGURATION_SET (event publishing) is optional. Email sign-in stays off
# in production until SES_PRODUCTION_ACCESS=true, set once AWS moves the
# account out of the sandbox. Every other environment captures email and never
# calls SES, so leave these unset outside production.
# SES_REGION=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_FROM=
# SES_CONFIGURATION_SET=
# SES_PRODUCTION_ACCESS=

# --- Payments ----------------------------------------------------------------
# Fees are paid through Razorpay Checkout: the API key pair (Dashboard →
# Account & Settings → API Keys) and the secret of the webhook pointed at
# /api/webhooks/razorpay. Set all three or none. Production takes only live
# keys (rzp_live_) and refuses every payment without them; every other
# environment takes only test keys (rzp_test_) and, without keys, pays through
# the app's own test checkout instead, so local runs and CI need none.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- File storage ------------------------------------------------------------
# Private uploads go to Cloudflare R2 through its S3 API: the browser PUTs and
# GETs through short-lived presigned URLs. Set all four or none. Without them
# a deployment refuses every upload and download (production stays that way
# until FOA's R2 buckets exist), and a local run keeps files on this machine
# instead (under the system temp folder, served by the app's own
# /api/local-storage), so uploads work locally and in CI with no R2 account.
# Staging and previews share the non-production bucket, each under its own key
# prefix (staging/, pr-<n>/, br-<hash>/); a local run uses local/. The bucket's
# CORS rules must allow PUT and GET from the site's origins.
#   R2_ACCOUNT_ID: the Cloudflare account id (32 hex characters)
#   R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: an R2 API token scoped to the bucket
# Blog post images' resized public copies go to a second bucket named
# <R2_BUCKET>-public (#112), so the token must reach that bucket too. Until it
# exists, an uploaded post image never becomes ready to publish.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Where browsers load the public bucket's objects: its custom domain, https
# only (#112). The public blog shows uploaded post images from here and the
# CSP allows it for images. Unset, the public site shows no uploaded image.
# PUBLIC_ASSET_BASE_URL=https://assets.friendsofanimals.dev/

# --- Error tracking (Sentry) ------------------------------------------------
# The app's Sentry DSN (Sentry → Project settings → Client Keys). Public by
# design: the browser sends its errors with it, through the app's own
# /monitoring route. Leave it empty locally and in CI: error tracking is
# then off and the SDK is never loaded. APP_ENV=production requires it.
# The browser reads it at build time, the server at runtime, so set it for
# both. Every event carries APP_ENV as its environment.
NEXT_PUBLIC_SENTRY_DSN=

# The VPS workers' Sentry DSN (their own Sentry project, HR-22), read by
# `pnpm worker` and `pnpm worker:dev`; on the VPS it comes from
# /etc/foa/secrets/worker_sentry.env (docker/workers.yml). Leave it empty
# locally: the worker then reports nowhere and never loads the SDK.
SENTRY_DSN=

# --- Analytics ---------------------------------------------------------------
# Cookieless page views through the self-hosted Umami (docker/README.md,
# "Analytics (Umami)"). Only staging and production builds with both set send
# anything; local runs and previews never do, so leave them unset here.
# This deployment's Umami website id (a UUID); staging and production each
# have their own.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# The Umami server's https origin, e.g. https://stats.shipped-it.dev. The site
# proxies /stats/script.js and /stats/api/send to it.
# UMAMI_ORIGIN=

# --- Malware scanner (ClamAV) -----------------------------------------------
# Every upload is scanned by clamd before anyone but its uploader may open it.
# On the VPS the workers reach the `foa-clamav` sidecar at foa-clamav:3310
# (docker/workers.yml). Unset, every scan on a deployment fails and uploads
# wait, unscanned, until a worker with a scanner retries them: never set on
# Vercel, which can't reach clamd. Unset on a local run, a stand-in scanner
# that flags only the EICAR test file checks uploads, so files turn clean
# once the outbox is drained; point it at a clamd of your own to scan for
# real.
# CLAMD_HOST=
# CLAMD_PORT=3310

# --- Off-site copy of files (worker-prod only, #68) --------------------------
# The VPS worker copies production's R2 buckets to Backblaze B2 each night;
# the app never reads these, and outside APP_ENV=production nothing is
# copied. Settings and the restore runbook: docker/README.md ("Off-site copy
# of files"). Each may instead be a file path in <NAME>_FILE (Compose secret).
# OFFSITE_SOURCE_BUCKETS=
# OFFSITE_RETENTION_DAYS=30
# OFFSITE_R2_ACCESS_KEY_ID=
# OFFSITE_R2_SECRET_ACCESS_KEY=
# B2_S3_ENDPOINT=
# B2_REGION=
# B2_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# Only for `pnpm offsite:restore`, typed in by the operator for one run:
# OFFSITE_RESTORE_R2_ACCESS_KEY_ID=
# OFFSITE_RESTORE_R2_SECRET_ACCESS_KEY=
