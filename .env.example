# Copy to .env for local development:  cp .env.example .env
# Values below match the `db` service in docker-compose.yml.

# --- Database ---------------------------------------------------------------
# Postgres connection string.
#   Local (docker compose up -d db): postgres://rescue:rescue@localhost:5432/rescue
#   Inside docker compose:           postgres://rescue:rescue@db:5432/rescue (set by compose)
#   Vercel + Neon:                   use the Neon connection string. With the *pooled*
#                                    URL (host contains "-pooler") prepared statements
#                                    must be disabled (postgres.js `prepare: false`).
DATABASE_URL=postgres://rescue:rescue@localhost:5432/rescue

# --- Sessions ---------------------------------------------------------------
# Secret used to sign session cookies. Use a long random value in production,
# e.g. `openssl rand -base64 32`. Rotating it logs everyone out.
SESSION_SECRET=dev-only-insecure-session-secret-change-me

# --- Uploads ----------------------------------------------------------------
# Where uploaded images are stored:
#   local -> files on disk under UPLOAD_DIR (dev, docker compose / self-hosting)
#   blob  -> Vercel Blob (production on Vercel; needs BLOB_READ_WRITE_TOKEN)
STORAGE_DRIVER=local

# Directory for STORAGE_DRIVER=local. Relative paths resolve from the project root.
# The Docker image uses /data/uploads (a named volume in docker-compose.yml).
UPLOAD_DIR=./data/uploads

# Vercel Blob read/write token, only needed when STORAGE_DRIVER=blob.
# Vercel sets it automatically when a Blob store is connected to the project;
# for local testing copy it from the store's settings or `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
